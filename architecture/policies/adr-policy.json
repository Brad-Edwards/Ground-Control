{
  "version": 1,
  "policies": [
    {
      "id": "ADR-021",
      "title": "Gated Agentic Development Loop",
      "adrPath": "architecture/adrs/021-gated-agentic-development-loop.md",
      "rules": [
        {
          "id": "workflow-guardrail-sync",
          "whenAny": [
            "skills/implement/SKILL.md",
            "skills/implement/_development-principles.md",
            "skills/implement/steps/**",
            "skills/quickfix/SKILL.md",
            "skills/integrate/SKILL.md",
            ".claude/skills/implement/SKILL.md",
            ".claude/skills/integrate/SKILL.md",
            ".claude/agents/completion-verifier.md",
            ".claude/rules/*.md",
            ".claude/hooks/verify-extra.sh",
            ".github/PULL_REQUEST_TEMPLATE.md",
            "AGENTS.md"
          ],
          "requireAll": [
            "docs/DEVELOPMENT_WORKFLOW.md",
            "docs/WORKFLOW.md",
            "architecture/adrs/021-gated-agentic-development-loop.md",
            "architecture/adrs/029-issue-thread-gate-model.md",
            "architecture/adrs/031-codex-review-stopping-model.md",
            "architecture/adrs/036-per-step-routing-tool-surfaces-telemetry.md",
            "skills/quickfix/SKILL.md"
          ],
          "message": "Workflow guardrails changed without syncing ADR-021 / ADR-029 / ADR-031 / ADR-036, workflow docs, and the /quickfix sibling lane."
        }
      ]
    },
    {
      "id": "ADR-014",
      "title": "Pluggable Verification Architecture",
      "adrPath": "architecture/adrs/014-pluggable-verification-architecture.md",
      "rules": [
        {
          "id": "verification-architecture-sync",
          "whenAny": [
            "specs/tla/**",
            "backend/src/main/java/com/keplerops/groundcontrol/domain/verification/**",
            "backend/src/main/java/com/keplerops/groundcontrol/infrastructure/verifiers/**",
            "tools/ground_control/**"
          ],
          "requireAll": [
            "docs/architecture/ARCHITECTURE.md",
            "architecture/adrs/014-pluggable-verification-architecture.md"
          ],
          "message": "Verification architecture changed without syncing ADR-014 and architecture docs."
        }
      ]
    },
    {
      "id": "ADR-012",
      "title": "Formal Methods Development Process",
      "adrPath": "architecture/adrs/012-formal-methods-process.md",
      "rules": [
        {
          "id": "formal-methods-sync",
          "whenAny": [
            "backend/gradle/openjml.gradle.kts",
            "backend/src/main/java/com/keplerops/groundcontrol/domain/**/state/*.java",
            "specs/tla/**"
          ],
          "requireAll": [
            "docs/CODING_STANDARDS.md",
            "architecture/adrs/012-formal-methods-process.md"
          ],
          "message": "Formal methods surfaces changed without syncing ADR-012 and coding standards."
        }
      ]
    },
    {
      "id": "ADR-054",
      "title": "Documentation Coverage Gate",
      "adrPath": "architecture/adrs/054-documentation-coverage-gate.md",
      "rules": [
        {
          "id": "doc-coverage-gate-sync",
          "whenAny": [
            "mcp/ground-control/lib.js",
            "mcp/ground-control/index.js",
            "tools/policy/checks.py",
            "tools/install-vale.sh",
            ".vale.ini",
            "docs/DOC_STYLE.md"
          ],
          "requireAll": [
            "architecture/adrs/054-documentation-coverage-gate.md",
            "docs/DOC_STYLE.md"
          ],
          "message": "Documentation coverage gate surfaces changed without syncing ADR-054 and DOC_STYLE.md."
        }
      ]
    },
    {
      "id": "ADR-090",
      "title": "Production-Line Measurement Model",
      "adrPath": "architecture/adrs/090-production-line-measurement-model.md",
      "rules": [
        {
          "id": "measurement-model-sync",
          "whenAny": [
            "backend/src/main/java/com/keplerops/groundcontrol/domain/workflowtelemetry/**",
            "backend/src/main/java/com/keplerops/groundcontrol/api/workflowtelemetry/**",
            "backend/src/main/java/com/keplerops/groundcontrol/domain/mcptelemetry/**",
            "backend/src/main/java/com/keplerops/groundcontrol/api/mcptelemetry/**",
            "mcp/ground-control/gc-workflow-run.js",
            "mcp/ground-control/gc-workflow-run-ingest.js",
            "mcp/ground-control/telemetry.js",
            "mcp/ground-control/workflow-run-lifecycle.js",
            "mcp/ground-control/gc-implement-mechanical.js"
          ],
          "requireAll": [
            "architecture/adrs/090-production-line-measurement-model.md"
          ],
          "message": "Process-measurement emitter surfaces changed without syncing ADR-090. Every emitter maps to one measurement model; a record-shape change that skips the ADR re-creates the divergence it closes."
        }
      ]
    }
  ]
}
