{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gc.implement.final-report.v1",
  "title": "Implement final report marker payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issueNumber",
    "phase",
    "requirements",
    "ciStatus",
    "sonarStatus",
    "reviews"
  ],
  "properties": {
    "issueNumber": {
      "type": "integer",
      "minimum": 1
    },
    "phase": {
      "type": "string",
      "enum": [
        "pre_merge",
        "post_merge"
      ]
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]+-[A-Z0-9]+[0-9]*$"
      }
    },
    "ciStatus": {
      "type": "string",
      "enum": [
        "green",
        "red",
        "skipped"
      ]
    },
    "sonarStatus": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "skipped"
      ]
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "x-ground-control-invariants": [
    {
      "id": "gc.implement.final-report.review-evidence-present",
      "description": "A final report cannot claim readiness without recorded review evidence.",
      "enforcedBy": [
        "tools/tests/test_policy_authz_matrix_sync.py::test_implement_final_report_schema_requires_review_evidence_invariant"
      ]
    }
  ]
}
