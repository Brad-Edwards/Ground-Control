{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gc.workflow.ci-observation.v1",
  "title": "CI-observation activity input and output",
  "description": "Phase D CI check observation. Backed by the GitHub workflow port. Only check names/states cross the boundary, never raw CI logs.",
  "x-ground-control-invariants": [
    {
      "id": "gc.workflow.ci-observation.record-schema-conformance",
      "description": "CI-observation records tagged x-gc-record serialize to documents valid against this schema.",
      "enforcedBy": [
        "backend/src/test/java/com/keplerops/groundcontrol/unit/infrastructure/temporal/implement/WorkflowContractConformanceTest.java::workflowPayloadRecordsConformToSchemas"
      ]
    }
  ],
  "$defs": {
    "CiObservationInput": {
      "x-gc-record": "CiObservationInput",
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "prNumber"],
      "properties": {
        "repository": { "type": "object" },
        "prNumber": { "type": "integer", "minimum": 1 }
      }
    },
    "CiObservationResult": {
      "x-gc-record": "CiObservationResult",
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "type": "string", "enum": ["PENDING", "SUCCESS", "FAILURE"] },
        "failedChecks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 200 },
          "maxItems": 200
        }
      }
    }
  }
}
