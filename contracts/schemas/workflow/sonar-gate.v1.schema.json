{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gc.workflow.sonar-gate.v1",
  "title": "SonarCloud quality-gate activity input and output",
  "description": "Phase D SonarCloud quality-gate validation. Backed by the Sonar gate port. Only the gate status crosses the boundary.",
  "x-ground-control-invariants": [
    {
      "id": "gc.workflow.sonar-gate.record-schema-conformance",
      "description": "Sonar-gate records tagged x-gc-record serialize to documents valid against this schema.",
      "enforcedBy": [
        "backend/src/test/java/com/keplerops/groundcontrol/unit/infrastructure/temporal/implement/WorkflowContractConformanceTest.java::workflowPayloadRecordsConformToSchemas"
      ]
    }
  ],
  "$defs": {
    "SonarGateInput": {
      "x-gc-record": "SonarGateInput",
      "type": "object",
      "additionalProperties": false,
      "required": ["projectKey", "prNumber"],
      "properties": {
        "projectKey": { "type": "string", "minLength": 1, "maxLength": 200 },
        "prNumber": { "type": "integer", "minimum": 1 }
      }
    },
    "SonarGateResult": {
      "x-gc-record": "SonarGateResult",
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["OK", "ERROR", "PENDING", "NONE"] }
      }
    }
  }
}
