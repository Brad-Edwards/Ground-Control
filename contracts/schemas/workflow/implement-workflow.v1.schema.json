{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gc.workflow.implement-workflow.v1",
  "title": "Deterministic /implement workflow input and result",
  "description": "Top-level input and result payloads for the GC-O009 deterministic core /implement Temporal workflow (ADR-028/ADR-081 phase 2). Bounded, ID/enum-only; no raw prose, secrets, or provider payloads in Temporal history.",
  "x-ground-control-invariants": [
    {
      "id": "gc.workflow.implement-workflow.record-schema-conformance",
      "description": "Each Java record tagged x-gc-record serializes to a document valid against this schema def.",
      "enforcedBy": [
        "backend/src/test/java/com/keplerops/groundcontrol/unit/infrastructure/temporal/implement/WorkflowContractConformanceTest.java::workflowPayloadRecordsConformToSchemas"
      ]
    },
    {
      "id": "gc.workflow.implement-workflow.phase-outcome-closed-vocabulary",
      "description": "ImplementPhase and ImplementOutcome are closed vocabularies distinct from the ADR-061 WorkflowRunState reporting projection; the Java enums equal the schema enum lists.",
      "enforcedBy": [
        "backend/src/test/java/com/keplerops/groundcontrol/unit/infrastructure/temporal/implement/WorkflowContractConformanceTest.java::implementPhaseAndOutcomeEnumsMatchSchema"
      ]
    }
  ],
  "$defs": {
    "ImplementWorkflowInput": {
      "x-gc-record": "ImplementWorkflowInput",
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "issueNumber", "completionCommand"],
      "properties": {
        "project": { "type": "string", "minLength": 1, "maxLength": 200 },
        "issueNumber": { "type": "integer", "minimum": 1 },
        "completionCommand": { "type": "string", "minLength": 1, "maxLength": 500 },
        "sonarProjectKey": { "type": ["string", "null"], "maxLength": 200 },
        "reviewCap": { "type": ["integer", "null"], "minimum": 1, "maximum": 10 },
        "requirementUids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 100 },
          "maxItems": 100
        },
        "pollIntervalSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 }
      }
    },
    "ImplementWorkflowResult": {
      "x-gc-record": "ImplementWorkflowResult",
      "type": "object",
      "additionalProperties": false,
      "required": ["issueNumber", "terminalPhase", "outcome", "reconciled"],
      "properties": {
        "issueNumber": { "type": "integer", "minimum": 1 },
        "terminalPhase": {
          "type": "string",
          "enum": [
            "A_PLAN_IMPLEMENT",
            "B_QUALITY_GATE",
            "C_STAGE_COMMIT_PUSH",
            "D_SHIP_PIPELINE",
            "E_POST_MERGE_RECONCILE"
          ]
        },
        "outcome": {
          "type": "string",
          "enum": ["READY_FOR_REVIEW", "MERGED", "ESCALATED", "CANCELLED"]
        },
        "prNumber": { "type": ["integer", "null"], "minimum": 1 },
        "reconciled": { "type": "boolean" }
      }
    }
  }
}
