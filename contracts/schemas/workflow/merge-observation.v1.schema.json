{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gc.workflow.merge-observation.v1",
  "title": "Merge-observation activity input and output",
  "description": "Phase D/E merge observation. PR merge is the single synchronous human gate, observed from GitHub as the authoritative event via a polling activity (ADR-029) — never modeled as a Temporal signal.",
  "x-ground-control-invariants": [
    {
      "id": "gc.workflow.merge-observation.record-schema-conformance",
      "description": "Merge-observation records tagged x-gc-record serialize to documents valid against this schema.",
      "enforcedBy": [
        "backend/src/test/java/com/keplerops/groundcontrol/unit/infrastructure/temporal/implement/WorkflowContractConformanceTest.java::workflowPayloadRecordsConformToSchemas"
      ]
    }
  ],
  "$defs": {
    "MergeObservationInput": {
      "x-gc-record": "MergeObservationInput",
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "prNumber"],
      "properties": {
        "repository": { "type": "object" },
        "prNumber": { "type": "integer", "minimum": 1 }
      }
    },
    "MergeObservationResult": {
      "x-gc-record": "MergeObservationResult",
      "type": "object",
      "additionalProperties": false,
      "required": ["merged", "prState"],
      "properties": {
        "merged": { "type": "boolean" },
        "prState": { "type": "string", "enum": ["OPEN", "MERGED", "CLOSED"] }
      }
    }
  }
}
