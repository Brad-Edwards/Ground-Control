{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gc.workflow.content-activities.v1",
  "title": "Content-activity seam input and output payloads",
  "description": "Bounded I/O contracts for the /implement content/LLM/review activity seams (author-plan, implement-change, codex review, test-quality review, readiness record, final report). The workflow references these so the A-E graph is complete; their activity IMPLEMENTATIONS land in later program phases (#1280 LLM activities, #1281 bridge). Only bounded results (posted flags, ids, verdicts, counts) cross the Temporal boundary — never plan prose, code, review transcripts, prompts, or completions.",
  "x-ground-control-invariants": [
    {
      "id": "gc.workflow.content-activities.record-schema-conformance",
      "description": "Content-activity seam records tagged x-gc-record serialize to documents valid against this schema.",
      "enforcedBy": [
        "backend/src/test/java/com/keplerops/groundcontrol/unit/infrastructure/temporal/implement/WorkflowContractConformanceTest.java::workflowPayloadRecordsConformToSchemas"
      ]
    }
  ],
  "$defs": {
    "AuthorPlanInput": {
      "x-gc-record": "AuthorPlanInput",
      "type": "object",
      "additionalProperties": false,
      "required": ["issueNumber", "idempotencyKey"],
      "properties": {
        "issueNumber": { "type": "integer", "minimum": 1 },
        "requirementUids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 100 },
          "maxItems": 100
        },
        "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "AuthorPlanResult": {
      "x-gc-record": "AuthorPlanResult",
      "type": "object",
      "additionalProperties": false,
      "required": ["posted"],
      "properties": {
        "posted": { "type": "boolean" },
        "commentId": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "ImplementChangeInput": {
      "x-gc-record": "ImplementChangeInput",
      "type": "object",
      "additionalProperties": false,
      "required": ["issueNumber", "idempotencyKey"],
      "properties": {
        "issueNumber": { "type": "integer", "minimum": 1 },
        "planCommentId": { "type": ["integer", "null"], "minimum": 1 },
        "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "ImplementChangeResult": {
      "x-gc-record": "ImplementChangeResult",
      "type": "object",
      "additionalProperties": false,
      "required": ["filesChanged", "testsAdded", "changelogUpdated", "clauseMappingComplete"],
      "properties": {
        "filesChanged": { "type": "integer", "minimum": 0 },
        "testsAdded": { "type": "integer", "minimum": 0 },
        "changelogUpdated": { "type": "boolean" },
        "clauseMappingComplete": { "type": "boolean" }
      }
    },
    "CodexReviewInput": {
      "x-gc-record": "CodexReviewInput",
      "type": "object",
      "additionalProperties": false,
      "required": ["issueNumber", "cap"],
      "properties": {
        "issueNumber": { "type": "integer", "minimum": 1 },
        "cap": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "CodexReviewResult": {
      "x-gc-record": "CodexReviewResult",
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "blockingFindings", "cyclesRun"],
      "properties": {
        "verdict": { "type": "string", "enum": ["ship", "ship-with-fixes", "dont-ship"] },
        "blockingFindings": { "type": "integer", "minimum": 0 },
        "cyclesRun": { "type": "integer", "minimum": 0 }
      }
    },
    "TestQualityReviewInput": {
      "x-gc-record": "TestQualityReviewInput",
      "type": "object",
      "additionalProperties": false,
      "required": ["issueNumber", "cap"],
      "properties": {
        "issueNumber": { "type": "integer", "minimum": 1 },
        "cap": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "TestQualityReviewResult": {
      "x-gc-record": "TestQualityReviewResult",
      "type": "object",
      "additionalProperties": false,
      "required": ["clean", "findings", "cyclesRun"],
      "properties": {
        "clean": { "type": "boolean" },
        "findings": { "type": "integer", "minimum": 0 },
        "cyclesRun": { "type": "integer", "minimum": 0 }
      }
    },
    "ReadinessRecordInput": {
      "x-gc-record": "ReadinessRecordInput",
      "type": "object",
      "additionalProperties": false,
      "required": ["issueNumber", "prNumber", "idempotencyKey"],
      "properties": {
        "issueNumber": { "type": "integer", "minimum": 1 },
        "prNumber": { "type": "integer", "minimum": 1 },
        "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "ReadinessRecordResult": {
      "x-gc-record": "ReadinessRecordResult",
      "type": "object",
      "additionalProperties": false,
      "required": ["posted"],
      "properties": {
        "posted": { "type": "boolean" },
        "commentId": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "FinalReportInput": {
      "x-gc-record": "FinalReportInput",
      "type": "object",
      "additionalProperties": false,
      "required": ["issueNumber", "prNumber", "idempotencyKey"],
      "properties": {
        "issueNumber": { "type": "integer", "minimum": 1 },
        "prNumber": { "type": "integer", "minimum": 1 },
        "requirementUids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 100 },
          "maxItems": 100
        },
        "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "FinalReportResult": {
      "x-gc-record": "FinalReportResult",
      "type": "object",
      "additionalProperties": false,
      "required": ["posted"],
      "properties": {
        "posted": { "type": "boolean" },
        "commentId": { "type": ["integer", "null"], "minimum": 1 }
      }
    }
  }
}
