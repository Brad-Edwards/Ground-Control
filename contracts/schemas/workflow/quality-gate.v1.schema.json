{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gc.workflow.quality-gate.v1",
  "title": "Quality-gate evaluation activity input and output",
  "description": "Phase B hard completion gate evaluation, combining build success, changelog-updated, and clause-mapping-complete facts via QualityGateService. Gate order is preserved, not weakened (GC-O007/ADR-029).",
  "x-ground-control-invariants": [
    {
      "id": "gc.workflow.quality-gate.record-schema-conformance",
      "description": "Quality-gate records tagged x-gc-record serialize to documents valid against this schema.",
      "enforcedBy": [
        "backend/src/test/java/com/keplerops/groundcontrol/unit/infrastructure/temporal/implement/WorkflowContractConformanceTest.java::workflowPayloadRecordsConformToSchemas"
      ]
    }
  ],
  "$defs": {
    "QualityGateInput": {
      "x-gc-record": "QualityGateInput",
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "buildPassed", "changelogUpdated", "clauseMappingComplete"],
      "properties": {
        "project": { "type": "string", "minLength": 1, "maxLength": 200 },
        "buildPassed": { "type": "boolean" },
        "changelogUpdated": { "type": "boolean" },
        "clauseMappingComplete": { "type": "boolean" }
      }
    },
    "QualityGateResult": {
      "x-gc-record": "QualityGateResult",
      "type": "object",
      "additionalProperties": false,
      "required": ["passed"],
      "properties": {
        "passed": { "type": "boolean" },
        "failedGates": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 200 },
          "maxItems": 100
        }
      }
    }
  }
}
