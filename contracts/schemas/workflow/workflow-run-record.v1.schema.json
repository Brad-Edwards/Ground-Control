{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gc.workflow.run-record.v1",
  "title": "Workflow run record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "repo",
    "issueNumber",
    "workflowType",
    "finalState",
    "provenance"
  ],
  "properties": {
    "project": {
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "issueNumber": {
      "type": "integer",
      "minimum": 1
    },
    "workflowType": {
      "type": "string",
      "enum": [
        "IMPLEMENT",
        "QUICKFIX",
        "CODEX_REVIEW",
        "TEST_QUALITY_REVIEW",
        "GRC_REVIEW",
        "PREFLIGHT",
        "OTHER"
      ]
    },
    "finalState": {
      "type": "string",
      "enum": [
        "RUNNING",
        "READY_FOR_REVIEW",
        "MERGED",
        "CLOSED",
        "ESCALATED",
        "ABANDONED",
        "SUPERSEDED",
        "FAILED"
      ]
    },
    "provenance": {
      "type": "string",
      "enum": [
        "ISSUE_THREAD",
        "TEMPORAL_VISIBILITY",
        "MANUAL_IMPORT",
        "LIVE_EMISSION"
      ]
    }
  },
  "x-ground-control-invariants": [
    {
      "id": "gc.workflow.run-record.phase-state-closed-set",
      "description": "Workflow run state and provenance are closed vocabularies.",
      "enforcedBy": [
        "tools/tests/test_policy_authz_matrix_sync.py::test_workflow_run_record_schema_has_closed_state_vocabulary_invariant"
      ]
    }
  ]
}
