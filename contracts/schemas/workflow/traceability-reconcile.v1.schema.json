{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gc.workflow.traceability-reconcile.v1",
  "title": "Traceability-reconcile activity input and output",
  "description": "Phase E IMPLEMENTS/TESTS traceability reconciliation against the merged diff. Backed by TraceabilityService; artifact identifiers are bounded paths.",
  "x-ground-control-invariants": [
    {
      "id": "gc.workflow.traceability-reconcile.record-schema-conformance",
      "description": "Traceability-reconcile records tagged x-gc-record serialize to documents valid against this schema.",
      "enforcedBy": [
        "backend/src/test/java/com/keplerops/groundcontrol/unit/infrastructure/temporal/implement/WorkflowContractConformanceTest.java::workflowPayloadRecordsConformToSchemas"
      ]
    }
  ],
  "$defs": {
    "TraceabilityReconcileInput": {
      "x-gc-record": "TraceabilityReconcileInput",
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "requirementUids", "prNumber", "idempotencyKey"],
      "properties": {
        "project": { "type": "string", "minLength": 1, "maxLength": 200 },
        "requirementUids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 100 },
          "maxItems": 100
        },
        "prNumber": { "type": "integer", "minimum": 1 },
        "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 200 },
        "implementsArtifacts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 500 },
          "maxItems": 1000
        },
        "testsArtifacts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 500 },
          "maxItems": 1000
        }
      }
    },
    "TraceabilityReconcileResult": {
      "x-gc-record": "TraceabilityReconcileResult",
      "type": "object",
      "additionalProperties": false,
      "required": ["implementsLinksCreated", "testsLinksCreated"],
      "properties": {
        "implementsLinksCreated": { "type": "integer", "minimum": 0 },
        "testsLinksCreated": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
