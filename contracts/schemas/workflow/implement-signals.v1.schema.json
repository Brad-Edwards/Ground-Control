{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gc.workflow.implement-signals.v1",
  "title": "Deterministic /implement workflow operator signal payloads",
  "description": "Closed catalog of contract-versioned operator signals the /implement workflow accepts (ADR-028 human-gate model). PR merge is observed, NOT signaled. The REST/MCP senders of these signals arrive in #1278/#1279; phase 2 defines the workflow-side handling contract only.",
  "x-ground-control-invariants": [
    {
      "id": "gc.workflow.implement-signals.record-schema-conformance",
      "description": "Each Java signal record tagged x-gc-record serializes to a document valid against this schema def.",
      "enforcedBy": [
        "backend/src/test/java/com/keplerops/groundcontrol/unit/infrastructure/temporal/implement/WorkflowContractConformanceTest.java::workflowPayloadRecordsConformToSchemas"
      ]
    }
  ],
  "$defs": {
    "CancelSignal": {
      "x-gc-record": "CancelSignal",
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "RetryFromSignal": {
      "x-gc-record": "RetryFromSignal",
      "type": "object",
      "additionalProperties": false,
      "required": ["phase"],
      "properties": {
        "phase": {
          "type": "string",
          "enum": [
            "A_PLAN_IMPLEMENT",
            "B_QUALITY_GATE",
            "C_STAGE_COMMIT_PUSH",
            "D_SHIP_PIPELINE",
            "E_POST_MERGE_RECONCILE"
          ]
        },
        "reason": { "type": "string", "maxLength": 500 }
      }
    },
    "ReviewCapDispositionSignal": {
      "x-gc-record": "ReviewCapDispositionSignal",
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "disposition"],
      "properties": {
        "reviewer": { "type": "string", "enum": ["codex", "test-quality"] },
        "disposition": {
          "type": "string",
          "enum": ["proceed", "one_more_cycle", "escalate_to_human"]
        }
      }
    }
  }
}
