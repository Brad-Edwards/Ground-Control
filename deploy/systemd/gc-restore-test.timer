[Unit]
Description=Ground Control restore-test timer (GC-P021: verify restores ≥ 1×/day)
Documentation=https://github.com/autarchy-ai/Ground-Control/blob/main/docs/operations/backup-restore.md

[Timer]
# 05:00 UTC daily — the GC-P021 recurring-verification cadence, staggered
# two hours after the 03:00 backup so the dump it tests is fresh.
# Persistent=true fires a catch-up run if the host was off when the slot
# elapsed; RandomizedDelaySec smooths startup load.
OnCalendar=*-*-* 05:00:00 UTC
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
