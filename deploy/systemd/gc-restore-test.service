[Unit]
Description=Ground Control restore test (GC-P021: verify backups on a recurring basis)
Documentation=https://github.com/Brad-Edwards/Ground-Control/blob/main/docs/operations/backup-restore.md
After=docker.service
Requires=docker.service
# AssertPathExists (not ConditionPathExists): a Condition* that fails makes
# systemd skip the unit with synthetic success, so a missing/deleted
# test-restore.sh would report green daily and accumulate false GC-P021
# verification evidence. Assert* fails the unit instead, raising the paging
# signal — exactly what a compliance-critical drill must do.
AssertPathExists=/opt/gc/test-restore.sh

[Service]
Type=oneshot
User=gc-backup
Group=gc-backup
ExecStart=/opt/gc/test-restore.sh
StandardOutput=journal
StandardError=journal
TimeoutStartSec=900

# Hardening mirrors gc-backup.service. The restore test only reads dumps
# from /data/backups and drives a throwaway container via the docker
# socket; it writes nothing of its own except whatever the docker CLI
# keeps under the gc-backup home. ProtectSystem=strict makes the rootfs
# read-only except ReadWritePaths; /data/backups is included read-mostly
# so a future ReadOnlyPaths tightening has an obvious anchor, and
# /var/lib/gc-backup covers docker CLI state. It deliberately needs NO
# access to /opt/gc/.env (the throwaway container uses a container-local
# password), so no ReadWritePaths or condition references the secret file.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data/backups /var/lib/gc-backup

[Install]
WantedBy=multi-user.target
