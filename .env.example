# Ground Control environment template.
#
# Copy to `.env` at the repo root. Nothing here is required: the MCP server
# starts and every registered tool works with none of these set. Each variable
# only switches on an optional behavior. There is no backend, database, or
# frontend to configure (issue #1500).
#
# The Ground Control MCP server reads this file at startup from the directory it
# was launched in. A shell-exported value always wins over the file. Keep `.env`
# gitignored and `chmod 600` if you put a real token in it; the server reads
# tokens in-process and never returns them through a tool result.
#
# Replace every placeholder below with a real value only in your local `.env`.

# ----------------------------------------------------------------------------
# Ground Control MCP server (mcp/ground-control) — see mcp/ground-control/README.md
# ----------------------------------------------------------------------------

# Sink for workflow-run lifecycle measurement emission. Unset disables the
# emitter entirely: the server never attempts the call.
# GC_BASE_URL=https://example.invalid

# Bearer token for that measurement emission, when the sink requires one.
# GROUND_CONTROL_API_TOKEN=replace-with-a-strong-random-secret

# Legacy token, preferred over the above for the two cross-project rollups.
# GROUND_CONTROL_PACK_REGISTRY_ADMIN_TOKEN=replace-with-a-strong-random-secret

# Per-invocation timeout for the Codex-backed tools (architecture preflight and
# review), within the bounds in mcp/ground-control/lib/model-subprocess.js.
# GC_CODEX_TIMEOUT_MS=1800000

# Run the core and security reviewers concurrently.
# GC_CODEX_REVIEW_PARALLEL=1

# Diff-slice budget for one review cycle, in bytes. 0 disables the cap.
# GC_CODEX_REVIEW_MAX_DIFF_BYTES=262144

# ----------------------------------------------------------------------------
# SonarCloud
# ----------------------------------------------------------------------------

# Lets gc_watch_sonar_analysis read the quality gate, and is the token the
# sonarqube MCP server in .mcp.json receives. CI supplies its own from secrets.
# SONAR_TOKEN=replace-with-a-sonarcloud-token

# ----------------------------------------------------------------------------
# Citation MCP server (mcp/citation) — research companion, optional
# ----------------------------------------------------------------------------

# Contact address sent to open scholarly APIs as the polite-pool identifier.
# CITATION_MCP_MAILTO=you@example.com

# Personal Zotero library credentials, when reading a private library.
# PERSONAL_ZOTERO_ID=replace-with-your-zotero-user-id
# PERSONAL_ZOTERO_KEY=replace-with-a-zotero-api-key

# Zotero translation server, when running one locally.
# TRANSLATION_SERVER_URL=http://localhost:1969
